digraph "Collaboration_1" {
  rankdir=TB;
  node [fontname="Helvetica" fontsize=12];
  edge [color="#666666" arrowsize=0.7];
  "collab_start" [shape=circle width=0.3 label="" style=filled fillcolor="#333333"];
  "collab_and_split" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="AND\nsplit"];
  "collab_end" [shape=doublecircle width=0.25 label=""];
  "collab_and_join" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="AND\njoin"];
  "start_customer" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="start"];
  "place_start_customer" [shape=circle width=0.22 label=""];
  "flow_c1" [shape=circle width=0.22 label=""];
  "end_customer" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="end"];
  "place_end_customer" [shape=circle width=0.22 label=""];
  "flow_c3" [shape=circle width=0.22 label=""];
  "start_restaurant" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="start"];
  "place_start_restaurant" [shape=circle width=0.22 label=""];
  "flow_r1" [shape=circle width=0.22 label=""];
  "end_restaurant" [shape=box style=filled fillcolor="#e4e4e7" color="#999999" fontsize=8 label="end"];
  "place_end_restaurant" [shape=circle width=0.22 label=""];
  "flow_r3" [shape=circle width=0.22 label=""];
  "task_send_order" [shape=box style="filled,rounded" fillcolor="#fde8df" color="#d97757" label="Order\nCustomer → Restaurant"];
  "flow_c2" [shape=circle width=0.22 label=""];
  "flow_r2" [shape=circle width=0.22 label=""];
  "task_send_confirmation" [shape=box style="filled,rounded" fillcolor="#fde8df" color="#d97757" label="Confirmation\nRestaurant → Customer"];
  "collab_start" -> "collab_and_split";
  "collab_and_split" -> "place_start_customer";
  "collab_and_split" -> "place_start_restaurant";
  "collab_and_join" -> "collab_end";
  "start_customer" -> "flow_c1";
  "place_start_customer" -> "start_customer";
  "flow_c1" -> "task_send_order";
  "end_customer" -> "place_end_customer";
  "place_end_customer" -> "collab_and_join";
  "flow_c3" -> "end_customer";
  "start_restaurant" -> "flow_r1";
  "place_start_restaurant" -> "start_restaurant";
  "flow_r1" -> "task_send_order";
  "end_restaurant" -> "place_end_restaurant";
  "place_end_restaurant" -> "collab_and_join";
  "flow_r3" -> "end_restaurant";
  "task_send_order" -> "flow_c2";
  "task_send_order" -> "flow_r2";
  "flow_c2" -> "task_send_confirmation";
  "flow_r2" -> "task_send_confirmation";
  "task_send_confirmation" -> "flow_r3";
  "task_send_confirmation" -> "flow_c3";
}